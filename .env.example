# =============================================================================
# A.R.M.O.R — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# This file (.env.example) contains NO real secrets and IS safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------

# Supabase project URL (from Supabase dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — client-safe, safe to include in mobile/web builds
# Found in: Supabase dashboard -> Settings -> API -> Project API keys -> anon key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service-role key — SERVER SIDE ONLY, NEVER expose to clients
# Required only for Phase 5+ Edge Functions (FCM triggers, admin operations)
# Found in: Supabase dashboard -> Settings -> API -> Project API keys -> service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Firebase (Phase 5+)
# -----------------------------------------------------------------------------

# Firebase project ID for FCM push notifications
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service account credentials JSON path (for server-side FCM)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# FCM Server Key (legacy, use service account for production)
# FCM_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Environment: development | staging | production
APP_ENV=development

# Application version (should match pubspec.yaml for Flutter app)
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Certificate Generation (Phase 3+)
# -----------------------------------------------------------------------------

# Secret salt for SHA-256 certificate hash generation
# Must be a long, random string. Generate with: openssl rand -hex 32
# CERT_HASH_SECRET=your-random-secret-here

# Certificate prefix for human-readable cert codes (e.g., SK-2026-JH-00001)
CERT_CODE_PREFIX=SK

# Certificate validity period in days (default: 365)
CERT_VALIDITY_DAYS=365

# -----------------------------------------------------------------------------
# Bhashini API (Phase 2+ for dynamic TTS, if needed)
# -----------------------------------------------------------------------------

# Bhashini API key (Government of India NLP platform)
# For Phase 1: Not required (audio pre-generated as MP3 assets)
# BHASHINI_API_KEY=your-bhashini-api-key

# ULCA API key for Bhashini
# BHASHINI_ULCA_API_KEY=your-ulca-api-key
