# =============================================================================
# A.R.M.O.R — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# This file (.env.example) contains NO real secrets and IS safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------

# Supabase project URL (from Supabase dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — client-safe, safe to include in mobile/web builds
# Found in: Supabase dashboard -> Settings -> API -> Project API keys -> anon key
SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase service-role key — SERVER SIDE ONLY, NEVER expose to clients / mobile
# Automatically injected into Supabase Edge Function environment
# Found in: Supabase dashboard -> Settings -> API -> Project API keys -> service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Certificate Verification Gateway (Phase 6/7)
# -----------------------------------------------------------------------------

# Public verification frontend URL base for physical/digital QR code scanning
# Set via: supabase secrets set CERT_VERIFY_BASE_URL="https://your-frontend.vercel.app/verify?code="
# Fallback during local development: https://armor-verify.internal/verify?code=
CERT_VERIFY_BASE_URL=https://your-verification-domain.example.com/verify?code=

# Certificate code prefix (e.g. SK-2026-JH-00001)
CERT_CODE_PREFIX=SK

# Certificate validity period in days (default: 365)
CERT_VALIDITY_DAYS=365

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Environment: development | staging | production
APP_ENV=development

# Application version (should match pubspec.yaml for Flutter app)
APP_VERSION=0.7.0
